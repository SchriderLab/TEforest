from snakemake.utils import min_version
import os

min_version("8.0")

ROOT = os.path.abspath(os.path.join(workflow.basedir, ".."))
SCRIPTS = os.path.join(ROOT, "scripts")

SAMPLES = config.get("samples", [])
if isinstance(SAMPLES, str):
    SAMPLES = [SAMPLES]

LABEL_MODE = config.get("label_mode", "classifier")
TRAIN_MODE = config.get("train_mode", LABEL_MODE)
TEST_SIZE = float(config.get("test_size", 0.0))
RANDOM_STATE = int(config.get("random_state", 42))
N_ESTIMATORS = int(config.get("n_estimators", 500))
N_JOBS = int(config.get("n_jobs", 8))
BAM_TO_FVEC_PROCS = int(config.get("bam_to_fvec_processes", config.get("threads", 1)))
MODEL_OUT = config.get("model_out", "training/teforest_classifier.pkl")

filter_ref_script = os.path.join(SCRIPTS, "remove_overlapping_reference.r")
candidate_regions_script = os.path.join(SCRIPTS, "find_candidate_regions_fast.sh")
process_regions_script = os.path.join(SCRIPTS, "process_candidate_regions.r")
label_regions_script = os.path.join(SCRIPTS, "label_candidate_regions_training.py")
bam_to_fvec_script = os.path.join(SCRIPTS, "bam_to_fvec_cov_normalized_rescale_regions_majorchanges.py")
condense_data_script = os.path.join(SCRIPTS, "condense_training_data.py")
train_model_script = os.path.join(SCRIPTS, "train_lightgbm_model_classifier_train.py")
downsample_reads_script = os.path.join(SCRIPTS, "downsample_reads.sh")


rule all:
    input:
        MODEL_OUT,


def find_fastq(base_path, sample, read):
    exts = ["fq", "fq.gz", "fastq", "fastq.gz"]
    patterns = [
        f"{base_path}{sample}_{read}.{{ext}}",
        f"{base_path}{sample}.R{read}.{{ext}}",
    ]
    for ext in exts:
        for pattern in patterns:
            file_path = pattern.format(ext=ext)
            if os.path.exists(file_path):
                return file_path
    raise ValueError(f"No valid input files found for sample {sample} read {read}")


rule filter_reference:
    input:
        ref_te_locations=config["ref_te_locations"],
    output:
        "ref_genome/filtered_ISO1.bed",
    shell:
        """
        mkdir -p fastp
        {filter_ref_script} {input.ref_te_locations}
        """


rule index_reference:
    input:
        ref=config["ref_genome"],
        consensusTEs=config["consensusTEs"]
    output:
        ref_copy="fastp/ref_genome",
        index_done="fastp/ref_genome.index.done"
    shell:
        """
        cat {input.ref} {input.consensusTEs} > {output.ref_copy}
        bwa-mem2 index fastp/ref_genome
        touch {output.index_done}
        """


rule fastp:
    input:
        fq1=lambda wildcards: find_fastq(config["fq_base_path"], wildcards.sample, "1"),
        fq2=lambda wildcards: find_fastq(config["fq_base_path"], wildcards.sample, "2")
    output:
        fq1_gz="fastp/{sample}.R1.fq",
        fq2_gz="fastp/{sample}.R2.fq",
        html="fastp/{sample}.html",
        json="fastp/{sample}.json",
    threads: config["threads"]
    log:
        "logs/{sample}/fastp.log",
    benchmark:
        "benchmarks/{sample}.fastp.benchmark.txt"
    shell:
        "fastp -w {threads} --dedup --detect_adapter_for_pe -i {input.fq1} -I {input.fq2} "
        "-o {output.fq1_gz} -O {output.fq2_gz} -h {output.html} -j {output.json} -z 4"


rule align_reads:
    input:
        "ref_genome/filtered_ISO1.bed",
        ref_index="fastp/ref_genome.index.done",
        fq1_qc="fastp/{sample}.R1.fq",
        fq2_qc="fastp/{sample}.R2.fq",
    output:
        bam="aligned/{sample}.bam",
    threads: config["threads"]
    benchmark:
        "benchmarks/{sample}.align_reads.benchmark.txt"
    log:
        "logs/{sample}/align_reads.log",
    shell:
        """
        bwa-mem2 mem -t {threads} fastp/ref_genome {input.fq1_qc} {input.fq2_qc} | \
            samtools sort -@ {threads} -o {output.bam} -
        samtools index {output.bam}
        """


rule downsample_reads:
    input:
        bam="aligned/{sample}.bam",
        ref_te_locations="ref_genome/filtered_ISO1.bed"
    output:
        bam_downsampled="downsampled/{sample}.bam",
        bai_downsampled="downsampled/{sample}.bam.bai",
        fq1="downsampled/{sample}_1.fq",
        fq2="downsampled/{sample}_2.fq",
        fq_single="downsampled/{sample}_singletons.fq",
        coverage="downsampled/{sample}_coverage.txt"
    threads: config["threads"]
    benchmark:
        "benchmarks/{sample}.downsample_reads.benchmark.txt"
    log:
        "logs/{sample}/downsample_reads.log"
    shell:
        """
        {downsample_reads_script} \
            {input.bam} \
            {threads} \
            downsampled \
            {wildcards.sample} \
            {input.ref_te_locations}
        """


rule candidate_regions:
    input:
        fq1_qc="downsampled/{sample}_1.fq",
        fq2_qc="downsampled/{sample}_2.fq",
        consensusTEs=config["consensusTEs"],
        ref_genome="fastp/ref_genome",
        ref_te_locations="ref_genome/filtered_ISO1.bed",
    output:
        directory("candidate_regions_data/{sample}"),
        "candidate_regions_data/{sample}/completed.txt",
    threads: config["threads"]
    benchmark:
        "benchmarks/{sample}.candidate_regions.benchmark.txt"
    log:
        "logs/{sample}/candidate_regions.log",
    shell:
        """
        ref_genome_name=$(basename {input.ref_genome})
        {candidate_regions_script} -e -o candidate_regions_data/{wildcards.sample} \
            -c {input.consensusTEs} -r {input.ref_te_locations} -@ {threads} \
            -g fastp/$ref_genome_name -1 {input.fq1_qc} -2 {input.fq2_qc} \
            -n {wildcards.sample}
        """


rule process_candidate_regions:
    input:
        "candidate_regions_data/{sample}/completed.txt",
        "candidate_regions_data/{sample}",
        euchromatin=config["euchromatin"],
        ref_te_locations=config["ref_te_locations"],
    output:
        featvec_csv="featvec_csvs/{sample}.csv",
        featvec_csv_ref="featvec_csvs/{sample}_reference.csv"
    benchmark:
        "benchmarks/{sample}.process_candidate_regions.benchmark.txt"
    log:
        "logs/{sample}/process_candidate_regions.log",
    shell:
        "{process_regions_script} {wildcards.sample} {input.euchromatin} {input.ref_te_locations}"


rule label_candidate_regions:
    input:
        candidates="featvec_csvs/{sample}.csv",
        truth=config["truth_bed"]
    output:
        labeled="featvec_csvs_labeled/{sample}.csv"
    params:
        label_mode=LABEL_MODE
    log:
        "logs/{sample}/label_candidate_regions.log",
    shell:
        """
        mkdir -p featvec_csvs_labeled
        python {label_regions_script} \
            --candidates {input.candidates} \
            --truth {input.truth} \
            --output {output.labeled} \
            --label-mode {params.label_mode}
        """


rule bam_to_fvec:
    input:
        featvec_csv="featvec_csvs_labeled/{sample}.csv",
        bam="downsampled/{sample}.bam",
    output:
        feat_vec_dir=directory("feature_vectors_train/{sample}"),
    benchmark:
        "benchmarks/{sample}.bam_to_fvec.benchmark.txt",
    threads: config["threads"]
    log:
        "logs/{sample}/bam_to_fvec.log",
    shell:
        """
        python {bam_to_fvec_script} \
              -i {input.featvec_csv} \
              -od feature_vectors_train \
              -bd downsampled \
              -tebd candidate_regions_data \
              -p {BAM_TO_FVEC_PROCS}
        """


rule condense_training_data:
    input:
        expand("feature_vectors_train/{sample}", sample=SAMPLES),
    output:
        npz="training/condense.npz"
    benchmark:
        "benchmarks/condense_training_data.benchmark.txt"
    log:
        "logs/condense_training_data.log"
    shell:
        """
        python {condense_data_script} -i feature_vectors_train -o {output.npz}
        """


rule train_model:
    input:
        npz="training/condense.npz"
    output:
        model=MODEL_OUT
    log:
        "logs/train_model.log"
    shell:
        """
        python {train_model_script} \
            --input-npz {input.npz} \
            --model-out {output.model} \
            --mode {TRAIN_MODE} \
            --test-size {TEST_SIZE} \
            --random-state {RANDOM_STATE} \
            --n-estimators {N_ESTIMATORS} \
            --n-jobs {N_JOBS}
        """
