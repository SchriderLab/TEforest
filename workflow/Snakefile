condense_data_script = workflow.basedir + "/scripts/condense_training_data.py"


rule condense_data:
    input:
        feat_vec_dir = "feature_vectors/{sample}"
    output:
        npz = "condensed_feature_vectors/{sample}/{sample}_condense.npz"
    benchmark:
        "benchmarks/{sample}.condense_data.benchmark.txt"
    log:
        "logs/{sample}/condense_data.log"
    shell:
        """
        python {condense_data_script} \
            -i {input.feat_vec_dir} \
            -o {output.npz} \
        """


rule condense_data_reference:
    input:
        feat_vec_dir="feature_vectors_reference/{sample}"
    output:
        npz="condensed_feature_vectors_reference/{sample}/{sample}_condense.npz"
    benchmark:
        "benchmarks/{sample}.condense_data.benchmark.txt"
    log:
        "logs/{sample}/condense_data.log"
    shell:
        r"""
        # 1) make sure output dir exists
        mkdir -p $(dirname {output.npz})

        # 2) quick check: are there any .npy files at all?
        if [ -z "$(find {input.feat_vec_dir} -maxdepth 1 -name '*.npy' -print -quit)" ]; then
            # 3) no regions → write an empty .npz so downstream rules still have a file
            python - << 'PYCODE'
import numpy as np
np.savez("{output.npz}")
PYCODE
        else
            # 4) normal path: drop tiny files and readcount arrays, then condense
            find {input.feat_vec_dir} -name "*readcount.npy" -delete
            find {input.feat_vec_dir} -type f -size -800c -exec rm -f {{}} +
            python {condense_data_script} -i {input.feat_vec_dir} -o {output.npz}
        fi
        """


rule condense_data_het:
    input:
        feat_vec_dir="feature_vectors_het/{sample}",
    output:
        npz="condensed_feature_vectors/{sample}/{sample}_condense_het.npz",
    benchmark:
        "benchmarks/{sample}.condense_data.benchmark.txt"
    log:
        "logs/{sample}/condense_data.log",
    shell:
        "python {condense_data_script} -i {input.feat_vec_dir} -o {output.npz}"


