rule index_ref:
    input:
        ref_genome    = config["ref_genome"],
        consensusTEs  = config["consensusTEs"]
    output:
        # merged FASTA + all the .amb/.ann/.pac/.bwt/.sa that bwa-mem2 will emit
        merged        = "ref_genome/{ref_basename}.fa",
        amb           = "ref_genome/{ref_basename}.fa.amb",
        ann           = "ref_genome/{ref_basename}.fa.ann",
        bwt           = "ref_genome/{ref_basename}.fa.bwt",
        pac           = "ref_genome/{ref_basename}.fa.pac",
        sa            = "ref_genome/{ref_basename}.fa.sa"
    params:
        outdir        = "ref_genome"
    shell:
        """
        mkdir -p {params.outdir}
        # concatenate genome + TE consensus into one FASTA
        cat {input.ref_genome} {input.consensusTEs} > {output.merged}
        # index it
        bwa-mem2 index {output.merged}
        """

def find_fastq(base_path, sample, read):
    matches = []
    for name in _list_fastq_files(base_path):
        stem = _strip_fastq_ext(name)
        remainder, priority = _sample_remainder(stem, sample)
        if remainder is None:
            continue
        read_token = _infer_read_token(remainder)
        if read_token is None:
            continue
        if str(read_token) == str(read):
            matches.append((priority, name))
    if not matches:
        raise ValueError(
            f"No valid input files found for sample {sample} read {read} in {base_path}."
        )
    matches.sort(key=lambda item: (item[0], item[1]))
    if len(matches) > 1:
        names = ", ".join(m[1] for m in matches)
        raise ValueError(
            f"Multiple FASTQ files matched sample {sample} read {read}: {names}. "
            "Please merge lanes or pass a directory with one FASTQ per read."
        )
    return os.path.join(base_path, matches[0][1])

rule fastp:
    input:
        fq1=lambda wildcards: find_fastq(config["fq_base_path"], wildcards.sample, "1"),
        fq2=lambda wildcards: find_fastq(config["fq_base_path"], wildcards.sample, "2")
    output:
        fq1_gz=maybe_temp("fastp/{sample}.R1.fq"),
        fq2_gz=maybe_temp("fastp/{sample}.R2.fq"),
        html="fastp/{sample}.html",
        json="fastp/{sample}.json",
    threads: 10,
    log:
        "logs/{sample}/fastp.log",
    benchmark:
        "benchmarks/{sample}.fastp.benchmark.txt"
    shell:
        "fastp -w {threads} --dedup --detect_adapter_for_pe -i {input.fq1} -I {input.fq2} -o fastp/{wildcards.sample}.R1.fq -O fastp/{wildcards.sample}.R2.fq -h fastp/{wildcards.sample}.html -j fastp/{wildcards.sample}.json -z 4"


