        """


rule select_model_nonreference:
    input:
        coverage="downsampled/{sample}_coverage.txt"
    output:
        model="selected_models/{sample}_nonreference.pkl",
        info="selected_models/{sample}_nonreference.txt"
    run:
        cov = parse_coverage_file(input.coverage)
        target_cov = choose_model_coverage(cov)
        src = model_path("nonreference", target_cov)
        os.makedirs(os.path.dirname(output.model), exist_ok=True)
        if not os.path.exists(src):
            raise FileNotFoundError(f"Model not found: {src}")
        if os.path.islink(output.model) or os.path.exists(output.model):
            os.remove(output.model)
        try:
            os.symlink(src, output.model)
        except OSError:
            import shutil
            shutil.copy2(src, output.model)
        with open(output.info, "w") as fh:
            fh.write(f"observed_coverage={cov}\n")
            fh.write(f"chosen_coverage={target_cov}\n")
            fh.write(f"model_path={src}\n")
        print(f"[select_model_nonreference] coverage={cov} -> {src}")


rule select_model_reference:
    input:
        coverage="downsampled/{sample}_coverage.txt"
    output:
        model="selected_models/{sample}_reference.pkl",
        info="selected_models/{sample}_reference.txt"
    run:
        cov = parse_coverage_file(input.coverage)
        target_cov = choose_model_coverage(cov)
        src = model_path("reference", target_cov)
        os.makedirs(os.path.dirname(output.model), exist_ok=True)
        if not os.path.exists(src):
            raise FileNotFoundError(f"Model not found: {src}")
        if os.path.islink(output.model) or os.path.exists(output.model):
            os.remove(output.model)
        try:
            os.symlink(src, output.model)
        except OSError:
            import shutil
            shutil.copy2(src, output.model)
        with open(output.info, "w") as fh:
            fh.write(f"observed_coverage={cov}\n")
            fh.write(f"chosen_coverage={target_cov}\n")
            fh.write(f"model_path={src}\n")
        print(f"[select_model_reference] coverage={cov} -> {src}")


rule align_reads_het:
    input:
        fq1_qc="fastp_het/{sample}.R1.fq",
        fq2_qc="fastp_het/{sample}.R2.fq",
        #fq1_qc="het_reads/{sample}/{sample}_1.fq",
        #fq2_qc="het_reads/{sample}/{sample}_2.fq",
        ref_index = "fastp/ref_genome.index.done",
    output:
        bam="aligned_het/{sample}.bam",
    threads: 32
    benchmark:
        "benchmarks/{sample}.align_reads.benchmark.txt"
    log:
        "logs/{sample}/align_reads.log",
    shell:
        """
        bwa-mem2 mem -t {threads} fastp/ref_genome {input.fq1_qc} {input.fq2_qc} | samtools sort -@ {threads} -o {output.bam} -
        samtools index {output.bam}
        """


