    output:
        predictions = "output/{sample}/predictions.csv"
    threads: config["threads"]
    benchmark:
        "benchmarks/{sample}.use_model.benchmark.txt"
    log:
        "logs/{sample}/use_model.log"
    shell:
        """
        python {use_model_script} \
            -n {input.npz} \
            -m {input.model} \
            -o output/{wildcards.sample} \
            -t {threads}
        """

